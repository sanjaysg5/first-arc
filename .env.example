# =============================================================================
# First Arc — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# =============================================================================

# Public site URL (used for metadata, OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email (Resend) ---------------------------------------------------------
# Optional in development — emails are skipped if unset.
RESEND_API_KEY=
# Internal recipient for new-lead notifications
LEAD_NOTIFICATION_EMAIL=hello@firstarc.ai
# Verified sender (must be a domain verified in Resend)
LEAD_FROM_EMAIL=First Arc <hello@firstarc.ai>

# --- Admin access -----------------------------------------------------------
# Comma-separated allowlist of admin emails (defense-in-depth with admin_users).
# These must also exist as Supabase Auth users to sign in.
ADMIN_EMAILS=you@yourcompany.com
